+
+def get_attn_fused_kernels():
+    if _kernel_attn_qkv_norm_rope is None:
+        get_gdn_fused_kernels()
+    return _kernel_attn_qkv_norm_rope, _kernel_attn_gate_prep
+
+
+@mx.compile
+def _gated_attn_out(output, gate):
+    return output.transpose(0, 2, 1, 3) * mx.sigmoid(gate)
+
+
+def fuse_prism_sibling_linears(model: Any, packed_cls: Any) -> int:
+    """Fuse sibling Packed projections that share the same input and Hadamard transform:
+      - mlp.gate_proj + mlp.up_proj -> mlp.gate_up_proj (64 layers)
+      - linear_attn.in_proj_qkv + linear_attn.in_proj_z -> linear_attn.in_proj_qkvz_fused (48 layers)
+      - linear_attn.in_proj_b + linear_attn.in_proj_a -> linear_attn.in_proj_ba_fused (48 layers)
+      - self_attn.q_proj + k_proj + v_proj -> self_attn.qkv_proj_fused (16 layers)
+    Also casts float32 norms/convs/signs (keeping SSM A_log and dt_bias in float32) to float16
+    so the residual stream stays in 16-bit across all 64 layers.
+    """
+    if getattr(model, "_dflash_prism_siblings_fused", False):
+        return 0
+    import mlx.nn as nn
+    import mlx_lm.models.qwen3_5 as q35
+    from mlx.utils import tree_flatten, tree_unflatten
+    from mlx_lm.models import cache as cache_mod
+    from mlx_lm.models.activations import swiglu
+    from mlx_lm.models.base import scaled_dot_product_attention
+    from mlx_lm.models.gated_delta import gated_delta_kernel, gated_delta_update, normalize_qk
+    import dflash_mlx.engine.target_qwen_gdn as tqg
+
+    def _fuse(mods):
+        w = mx.concatenate([m.weight for m in mods], axis=0)
+        s = mx.concatenate([m.scales for m in mods], axis=0)
+        b = mx.concatenate([m.biases for m in mods], axis=0)
+        signs = mods[0].signs.astype(mx.float16) if mods[0].signs is not None else None
+        mx.eval(w, s, b)
+        return packed_cls((w, s, b), mods[0].block, signs, False, mods[0].dtype)
+
+    import gc
+    inner = getattr(model, "model", model)
+    fused_count = 0
+    for idx, layer in enumerate(getattr(inner, "layers", [])):
+        mlp = getattr(layer, "mlp", None)
+        if mlp is not None and hasattr(mlp, "gate_proj") and hasattr(mlp, "up_proj"):
+            mlp.gate_up_proj = _fuse([mlp.gate_proj, mlp.up_proj])
+            del mlp.gate_proj
+            del mlp.up_proj
+            fused_count += 1
+        la = getattr(layer, "linear_attn", None)
+        if la is not None and hasattr(la, "in_proj_qkv") and hasattr(la, "in_proj_z"):
+            la.in_proj_qkvz_fused = _fuse([la.in_proj_qkv, la.in_proj_z])
+            del la.in_proj_qkv
+            del la.in_proj_z
+            fused_count += 1
+        if la is not None and hasattr(la, "in_proj_b") and hasattr(la, "in_proj_a"):
+            ba_w = mx.concatenate([la.in_proj_b.weight, la.in_proj_a.weight], axis=0).astype(mx.float16)
+            mx.eval(ba_w)
+            la._b_dim = int(la.in_proj_b.weight.shape[0])
+            la.in_proj_ba_fused = nn.Linear(ba_w.shape[1], ba_w.shape[0], bias=False)
+            la.in_proj_ba_fused.weight = ba_w
+            del la.in_proj_b
+            del la.in_proj_a
+        sa = getattr(layer, "self_attn", None)
+        if sa is not None and hasattr(sa, "q_proj") and hasattr(sa, "k_proj") and hasattr(sa, "v_proj"):
+            sa._q_dim = int(sa.q_proj.weight.shape[0])
+            sa._k_dim = int(sa.k_proj.weight.shape[0])
+            sa._has_gated_q = (sa._q_dim == 2 * sa.num_attention_heads * int(sa.q_norm.weight.shape[0]))
+            sa.qkv_proj_fused = _fuse([sa.q_proj, sa.k_proj, sa.v_proj])
+            del sa.q_proj
+            del sa.k_proj
+            del sa.v_proj
+            fused_count += 1
+        if (idx & 3) == 3:
+            mx.clear_cache()
+
+    gc.collect()
+    mx.clear_cache()
+
+    # Cast remaining float32 parameters (RMSNorm, conv1d) to float16
+    # while keeping recurrent SSM A_log and dt_bias in float32.
+    new_params = []
+    for k, v in tree_flatten(model.parameters()):
+        if isinstance(v, mx.array) and v.dtype == mx.float32 and ("A_log" not in k and "dt_bias" not in k):
+            new_params.append((k, v.astype(mx.float16)))
+        else:
+            new_params.append((k, v))
+    model.update(tree_unflatten(new_params))
+    for _, m in model.named_modules():
+        if hasattr(m, "signs") and isinstance(m.signs, mx.array) and m.signs.dtype == mx.float32:
+            m.signs = m.signs.astype(mx.float16)
+    mx.eval(model.parameters())
+    gc.collect()
+    mx.clear_cache()
+    if hasattr(mx, "reset_peak_memory"):
+        mx.reset_peak_memory()
+
+    k_gdn_prep, k_gdn_norm, k_gdn_norm_prep, k_prep_swiglu = get_gdn_fused_kernels()
+    k_res_norm_prep = _kernel_res_norm_prep
+
+    if not getattr(q35.MLP, "_dflash_prism_fused_hook", False):
+        orig_mlp_call = q35.MLP.__call__
+
+        def fused_mlp_call(self, x):
+            if hasattr(self, "gate_up_proj"):
+                gu = self.gate_up_proj(x)
+                d = gu.shape[-1] // 2
+                shape = x.shape
+                rows = 1
+                for dim in shape[:-1]:
+                    rows *= dim
+                dp = self.down_proj
+                if (
+                    1 <= rows <= 8
+                    and x.dtype == mx.float16
+                    and getattr(dp, "block", 0) == 1024
