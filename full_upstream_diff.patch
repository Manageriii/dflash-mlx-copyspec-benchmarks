diff --git a/lab/shape_costs.py b/lab/shape_costs.py
new file mode 100644
index 0000000..f18ed3f
--- /dev/null
+++ b/lab/shape_costs.py
@@ -0,0 +1,54 @@
+"""Per-shape cost of the Packed (Hadamard + 2-bit) linears at M = 1..8 rows, summed over the model.
+
+Prints, per distinct (N, K): count in the model, ms per call, effective GB/s (weights+scales+biases), GFLOP/s,
+and the model-wide sum — i.e. how much of verify(8) / decode(1) is the matmuls themselves.
+"""
+import os
+import sys
+import time
+from collections import Counter
+from pathlib import Path
+
+import mlx.core as mx
+
+PACK = os.environ.get("BONSAI2_PACK", str(Path.home() / "models/bonsai/Ternary-Bonsai-2-27B-Uncensored-Heretic-mlx-2bit"))
+sys.path.insert(0, PACK + "/runtime")
+from dflash_mlx.runtime.prism_pack import load_text_model  # noqa: E402
+
+model, _ = load_text_model(PACK)
+import runtime as prism_rt  # noqa: E402
+
+mods = [(n, m) for n, m in model.named_modules() if isinstance(m, prism_rt.Packed) and not m.embedding]
+shapes = Counter((int(m.weight.shape[0]), int(m.weight.shape[1]) * 16) for _, m in mods)
+rep = {}
+for n, m in mods:
+    rep.setdefault((int(m.weight.shape[0]), int(m.weight.shape[1]) * 16), m)
+
+
+def bench(m, M, reps=30):
+    K = int(m.weight.shape[1]) * 16
+    xs = [mx.random.normal((1, M, K)).astype(mx.float16) for _ in range(reps)]
+    mx.eval(xs)
+    for _ in range(3):
+        mx.eval(m(xs[0]))
+    # every output is evaluated: an un-evaluated lazy result is never computed (the first version of this
+    # benchmark evaluated only the last call and reported 3751 GB/s)
+    t0 = time.perf_counter()
+    ys = [m(x) for x in xs]
+    mx.eval(ys)
+    return (time.perf_counter() - t0) / reps * 1000
+
+
+rows = [1, 4, 8] if len(sys.argv) < 2 else [int(a) for a in sys.argv[1:]]
+tot = {M: 0.0 for M in rows}
+print(f"{'N':>7} {'K':>6} {'cnt':>4} " + " ".join(f"{'M='+str(M)+' ms':>10} {'GB/s':>6} {'GF/s':>6}" for M in rows))
+for (N, K), c in sorted(shapes.items(), key=lambda kv: -kv[0][0] * kv[0][1] * kv[1]):
+    m = rep[(N, K)]
+    nbytes = N * K / 4 + N * (K // 128) * 4
+    cells = []
+    for M in rows:
+        ms = bench(m, M)
+        tot[M] += ms * c
+        cells.append(f"{ms:10.3f} {nbytes / ms / 1e6:6.0f} {2 * N * K * M / ms / 1e6:6.0f}")
+    print(f"{N:7d} {K:6d} {c:4d} " + " ".join(cells))
+print("model-wide matmul sum: " + "  ".join(f"M={M}: {tot[M]:.1f} ms" for M in rows))
