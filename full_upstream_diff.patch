new file mode 100644
index 0000000..9ed8d82
--- /dev/null
+++ b/tests/test_request_thinking_budget.py
@@ -0,0 +1,38 @@
+# A request may state its own thinking budget (thinking_token_budget), which holds also for a long prompt; one without
+# it is served exactly as before, and no budget is left behind for the request after it.
+
+from __future__ import annotations
+
+import pytest
+
+from dflash_mlx.engine.spec_epoch import choose_reasoning_budget
+from dflash_mlx.serve import note_request_budget
+
+
+@pytest.fixture(autouse=True)
+def clean_env(monkeypatch):
+    for name in ("DFLASH_REQUEST_BUDGET", "DFLASH_REASONING_BUDGET", "DFLASH_ACTIVE_EFFORT"):
+        monkeypatch.delenv(name, raising=False)
+
+
+def test_a_long_prompt_keeps_4500_unless_the_request_states_less():
+    assert choose_reasoning_budget(8000, 20_000, 0) == 4500
+    note_request_budget({"thinking_token_budget": 1024})
+    assert choose_reasoning_budget(8000, 20_000, 0) == 1024
+    assert choose_reasoning_budget(900, 20_000, 0) == 64, "the 900-token rule is unchanged"
+    assert choose_reasoning_budget(1000, 20_000, 0) == 744, "within the output limit, leaving room for the answer"
+
+
+@pytest.mark.parametrize("given", [None, 0, -5, True, "1024", 10.5])
+def test_no_usable_budget_leaves_none_and_clears_the_one_before(given):
+    note_request_budget({"thinking_token_budget": 512})
+    note_request_budget({} if given is None else {"thinking_token_budget": given})
+    assert choose_reasoning_budget(8000, 20_000, 0) == 4500
+
+
+def test_short_prompts_follow_their_effort_as_before(monkeypatch):
+    monkeypatch.setenv("DFLASH_ACTIVE_EFFORT", "low")
+    assert choose_reasoning_budget(4096, 500, 0) == 512
+    monkeypatch.setenv("DFLASH_REASONING_BUDGET", "2000")
+    assert choose_reasoning_budget(4096, 500, 0) == 2000
+    assert choose_reasoning_budget(100, 500, 0) == 0
