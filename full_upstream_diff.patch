+        auto y_ = y + (b_idx * T * Hv + hv_idx) * Dv + dv_base;
+        auto tape_ = innovation_tape + (b_idx * T * Hv + hv_idx) * Dv + dv_base;
+
+        // state_in, state_out: [B, Hv, Dv, Dk]
+        auto s_offset = (n * Dv + dv_base) * Dk + col;
+        auto i_state = state_in + s_offset;
+        auto o_state = state_out + s_offset;
+
+        float4 s0 = *reinterpret_cast<const device packed_float4*>(i_state + 0 * Dk);
+        float4 s1 = *reinterpret_cast<const device packed_float4*>(i_state + 1 * Dk);
+        float4 s2 = *reinterpret_cast<const device packed_float4*>(i_state + 2 * Dk);
+        float4 s3 = *reinterpret_cast<const device packed_float4*>(i_state + 3 * Dk);
+
+        auto g_ = g + b_idx * T * Hv + hv_idx;
+        auto beta_ = beta + b_idx * T * Hv + hv_idx;
