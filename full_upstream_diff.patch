+    def _concat_linear(mods: list[nn.Linear]) -> nn.Linear:
+        has_bias = "bias" in mods[0]
+        w = mx.concatenate([m.weight for m in mods], axis=0)
+        lin = nn.Linear(int(w.shape[1]), int(w.shape[0]), bias=has_bias)
+        lin.weight = w
+        if has_bias:
