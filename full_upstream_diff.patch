+            mlp.gate_up_proj = _concat_linear([mlp.gate_proj, mlp.up_proj])
+            del mlp.gate_proj
+            del mlp.up_proj
+            fused += 1
+        sa = getattr(layer, "self_attn", None)
+        if sa is not None and hasattr(sa, "q_proj") and hasattr(sa, "k_proj") and hasattr(sa, "v_proj"):
+            sa.qkv_proj_fused = _concat_linear([sa.q_proj, sa.k_proj, sa.v_proj])
+            sa.kv_proj_fused = _concat_linear([sa.k_proj, sa.v_proj])
+            del sa.q_proj
+            del sa.k_proj
+            del sa.v_proj
+            fused += 1
+
