+++ b/dflash_mlx/engine/splitk_attention.py
@@ -0,0 +1,330 @@
+# Split-K GQA attention for the verify step at long context.
+#
+# MLX's attention for Bonsai 2's verify (8 query rows x 6 query heads per KV head = 48 rows, head_dim 256) runs as
+# about 8 threadgroups that each walk every key: 32 ms per verify over the 16 full-attention layers at 32k keys,
+# against a ~17 ms compute floor on this M4 Pro (101 GFLOP at the measured 5.9 TFLOPS fp16 matmul peak). Here the
+# keys are split into chunks across threadgroups (flash-decoding); each threadgroup takes one KV head and a run of
+# 128-key blocks:
+#   - its 8 simdgroups each compute S^T = K Q^T for 16 keys and all 48 rows, then O for 32 output dims and all 48 rows,
+#     so every K and V element is read from device memory once per threadgroup, straight into registers;
+#   - head dims and keys are permuted inside each 32-wide group (the sums do not care), so one 16-byte load per lane
+#     fills four 8x8 fragments; Q is gathered into that fragment order once per call;
+#   - P goes through threadgroup memory (double-buffered) with a lazy softmax: P = exp(s - m_ref) against a reference
+#     max that only moves, with the rescale and its extra barriers, when a score exceeds it by more than e^8, so a
+#     block costs one barrier;
+#   - accumulators are plain float2 registers wrapped into simdgroup matrices only around each multiply: writing a
+#     simdgroup_matrix's thread_elements() in place halved the throughput.
+# The last keys, where the causal mask applies, and the merge of the partials are one small second kernel.
+# Measured at 32k, 16 layers in one graph: 21 ms (MLX's grouped path 32 ms, the previous split-K kernel 35 ms).
+from __future__ import annotations
+
+from typing import Any, Optional
+
+import mlx.core as mx
+
+_CH = 128                # keys per block (16 per simdgroup)
+_TARGET_CHUNKS = 8       # threadgroups per KV head: 4-16 measure the same at 32k; 8 keeps short contexts busy
+MIN_KV_LEN = 4096        # below this MLX's grouped attention is as fast or faster (measured 1k-4k, q_len 8)
+_HEAD_DIM = 256
+
+_HEADER = r"""
+// D += A B on 8x8 fragments held as this lane's two elements (MLX steel layout); plain registers between calls
+inline void mma8(thread float2& d, half2 a, half2 b) {
+    simdgroup_float8x8 dm;
+    simdgroup_half8x8 am, bm;
+    reinterpret_cast<thread half2&>(am.thread_elements()) = a;
+    reinterpret_cast<thread half2&>(bm.thread_elements()) = b;
+    reinterpret_cast<thread float2&>(dm.thread_elements()) = d;
+    simdgroup_multiply_accumulate(dm, am, bm, dm);
+    d = reinterpret_cast<thread float2&>(dm.thread_elements());
+}
+"""
+
+_SOURCE = r"""
+    // RT row tiles of 8 rows; simdgroup s: keys 16 s .. +16 of each block for S, output dims 32 s .. +32 for O.
+    // A lane holds elements (row fm, cols fn, fn + 1) of every 8x8 fragment.
+    const uint c = threadgroup_position_in_grid.x;
+    const uint h = threadgroup_position_in_grid.y;
+    const uint n_chunks = threadgroups_per_grid.x;
+    const ushort s = simdgroup_index_in_threadgroup;
+    const ushort lane = thread_index_in_simdgroup;
+    const uint tid = thread_position_in_threadgroup.x;
+    constexpr int D = 256;
+    constexpr int BK = 128;
+    constexpr int R8 = RT * 8;
+    constexpr int PS = BK + 8;                 // P row stride in halves (padded)
+    constexpr float TAU = 8.0f;                // P <= e^8 = 2981 stays exact enough in fp16
+    const int total_blk = params[0];
+    const int n_blk = params[1];
+    const float sc = scale[0];
+    const int blk0 = int(c) * n_blk;
+    const int nb = min(n_blk, total_blk - blk0);
+
+    threadgroup uint4 Pbuf[2 * R8 * PS / 8];   // P [row][key slot], two blocks
+    threadgroup float part[8 * R8];            // per-simdgroup row maxima (rescale) and row sums (end)
+    threadgroup float m_ref[R8];
+    threadgroup float alpha[R8];
+    threadgroup int flag;                      // last block whose scores exceeded m_ref + TAU somewhere
+
+    const short fm = ((lane / 4) & 4) + ((lane / 2) % 4);
+    const short fn = ((lane / 4) & 2) * 2 + (lane % 2) * 2;
+
+    if (tid < uint(R8)) m_ref[tid] = -1.0e30f;
+    if (tid == 0) flag = -1;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    float mc[RT][2];                           // m_ref of this lane's S^T columns (rows 8 i + fn, + 1)
+    float lsum[RT];                            // sum of P over this lane's keys, row 8 i + fm
+    float2 acc[RT][4];                         // O: rows 8 i + fm, dims 32 s + 4 fn + 2 j .. +1
+    for (int i = 0; i < RT; i++) {
+        mc[i][0] = mc[i][1] = -1.0e30f;
+        lsum[i] = 0.0f;
+        for (int j = 0; j < 4; j++) acc[i][j] = float2(0.0f);
+    }
+
+    const device half* kh = k + (size_t)h * k_strides[1];
+    const device half* vh = v + (size_t)h * v_strides[1];
+    const size_t ks = k_strides[2];
+    const size_t vs = v_strides[2];
+    const device uint4* qf = (const device uint4*)qfrag + (size_t)h * 8 * RT * 32 + lane;
+    // key 16 s + 8 kt + fm of the block lands in P slot 32 (s / 2) + 4 (fm & ~1) + 2 (2 (s & 1) + kt) + (fm & 1),
+    // the order in which one 16-byte load hands a lane its P fragments for four 8-key steps
+    const int pcol = 32 * (s / 2) + 4 * (fm & ~1) + (fm & 1) + 4 * (s & 1);
+
+    for (int b = 0; b < nb; b++) {
+        const int blk = blk0 + b;
+        const int kb = blk * BK;
+        threadgroup half* Pb = (threadgroup half*)Pbuf + (b & 1) * (R8 * PS);
+        // S^T = K Q^T for keys kb + 16 s .. +16; d-group dg, tile t, column x <-> d = 32 dg + 4 x + t
+        float2 sacc[RT][2];
+        for (int i = 0; i < RT; i++) sacc[i][0] = sacc[i][1] = float2(0.0f);
+        const device half* k0 = kh + (size_t)(kb + 16 * s + fm) * ks + 4 * fn;
+        const device half* k1 = k0 + 8 * ks;
+        for (int dg = 0; dg < 8; dg++) {
+            const uint4 ka = *(const device uint4*)(k0 + 32 * dg);
+            const uint4 kc = *(const device uint4*)(k1 + 32 * dg);
+            for (int i = 0; i < RT; i++) {
+                const uint4 qv = qf[(dg * RT + i) * 32];
+                for (int t = 0; t < 4; t++) {
+                    mma8(sacc[i][0], as_type<half2>(ka[t]), as_type<half2>(qv[t]));
+                    mma8(sacc[i][1], as_type<half2>(kc[t]), as_type<half2>(qv[t]));
+                }
+            }
+        }
+        bool ex = false;
+        for (int i = 0; i < RT; i++)
+            for (int kt = 0; kt < 2; kt++)
+                for (int c2 = 0; c2 < 2; c2++) {
+                    const float x = sacc[i][kt][c2] * sc;
+                    ex |= x > mc[i][c2] + TAU;
+                    Pb[(8 * i + fn + c2) * PS + pcol + 2 * kt] = half(exp(x - mc[i][c2]));
+                }
+        if (simd_any(ex) && lane == 0) flag = blk;
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        if (flag == blk) {
+            // rare (always the first block): move m_ref to the true running max, rescale O and the sums, redo P
+            for (int i = 0; i < RT; i++)
+                for (int c2 = 0; c2 < 2; c2++) {
+                    float x = max(sacc[i][0][c2], sacc[i][1][c2]) * sc;
+                    x = max(x, simd_shuffle_xor(x, 2));
+                    x = max(x, simd_shuffle_xor(x, 4));
+                    x = max(x, simd_shuffle_xor(x, 16));
+                    if ((lane & 22) == 0) part[s * R8 + 8 * i + fn + c2] = x;
+                }
+            threadgroup_barrier(mem_flags::mem_threadgroup);
+            if (tid < uint(R8)) {
+                const float mo = m_ref[tid];
+                float m = mo;
+                for (int g = 0; g < 8; g++) m = max(m, part[g * R8 + tid]);
+                alpha[tid] = exp(mo - m);
+                m_ref[tid] = m;
+            }
+            threadgroup_barrier(mem_flags::mem_threadgroup);
+            for (int i = 0; i < RT; i++) {
+                mc[i][0] = m_ref[8 * i + fn];
+                mc[i][1] = m_ref[8 * i + fn + 1];
+                const float a = alpha[8 * i + fm];
+                lsum[i] *= a;
+                for (int j = 0; j < 4; j++) acc[i][j] *= a;
+            }
+            for (int i = 0; i < RT; i++)
+                for (int kt = 0; kt < 2; kt++)
+                    for (int c2 = 0; c2 < 2; c2++) {
+                        const float x = sacc[i][kt][c2] * sc;
+                        Pb[(8 * i + fn + c2) * PS + pcol + 2 * kt] = half(exp(x - mc[i][c2]));
+                    }
+            threadgroup_barrier(mem_flags::mem_threadgroup);
+        }
+        // O += P V; 8-key step u of group kg, column y <-> dim 32 s + 4 (y & ~1) + 2 j + (y & 1)
+        const device half* v0 = vh + (size_t)(kb + fm) * vs + 32 * s + 4 * fn;
+        for (int kg = 0; kg < 4; kg++) {
+            uint4 vv[4];
+            for (int u = 0; u < 4; u++) vv[u] = *(const device uint4*)(v0 + (size_t)(32 * kg + 8 * u) * vs);
+            for (int i = 0; i < RT; i++) {
+                const uint4 pv = *((const threadgroup uint4*)(Pb + (8 * i + fm) * PS + 32 * kg + 4 * fn));
+                const half4 pa = as_type<half4>(pv.xy), pb = as_type<half4>(pv.zw);
+                lsum[i] += (float(pa.x) + float(pa.y)) + (float(pa.z) + float(pa.w))
+                         + (float(pb.x) + float(pb.y)) + (float(pb.z) + float(pb.w));
+                for (int u = 0; u < 4; u++)
+                    for (int j = 0; j < 4; j++) mma8(acc[i][j], as_type<half2>(pv[u]), as_type<half2>(vv[u][j]));
+            }
+        }
+    }
+
+    // row sums: lanes sharing a row (fm) differ in lane bits 0 and 3; every simdgroup holds the same sums
+    if (s == 0) {
+        for (int i = 0; i < RT; i++) {
+            float l = lsum[i];
+            l += simd_shuffle_xor(l, 1);
+            l += simd_shuffle_xor(l, 8);
+            if ((lane & 9) == 0) part[8 * i + fm] = l;
+        }
+    }
+    device float* op = o_part + (size_t)(h * n_chunks + c) * R8 * D;
+    for (int i = 0; i < RT; i++) {
+        device float4* dst = (device float4*)(op + (size_t)(8 * i + fm) * D + 32 * s + 4 * fn);
+        dst[0] = float4(acc[i][0], acc[i][1]);
+        dst[1] = float4(acc[i][2], acc[i][3]);
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (tid < uint(R8)) {
+        const size_t o = ((size_t)(h * n_chunks + c) * R8 + tid) * 2;
+        ml_part[o] = m_ref[tid];
+        ml_part[o + 1] = part[tid];
+    }
+"""
+
+_MERGE = r"""
+    // threadgroup per (row, KV head), thread t owns dims 4t..4t+3: the tail keys [main, kv_len) exactly (causal
+    // mask), then out = (sum_c w_c o_c + w_t o_t) / (sum_c w_c l_c + w_t l_t), w = exp(m - max m)
+    const uint t = thread_position_in_threadgroup.x;
+    const uint row = threadgroup_position_in_grid.y, h = threadgroup_position_in_grid.z;
+    const uint sg = simdgroup_index_in_threadgroup, lane = thread_index_in_simdgroup;
+    const int kv_len = params[0], q_len = params[1], causal = params[2], main_ = params[3], n_chunks = params[4];
+    const int rows = params[5], r8 = params[6];
+    const int T = kv_len - main_;                                    // 1 .. 135
+    const int last = causal ? kv_len - q_len + int(row) % q_len : kv_len - 1;
+    threadgroup float sp[2][136];
+    const float4 qd = float4(*(const device half4*)(q + ((size_t)h * rows + row) * 256 + 4 * t));
+    const device half* kh = k + (size_t)h * k_strides[1] + 4 * t;
+    const device half* vh = v + (size_t)h * v_strides[1] + 4 * t;
+    for (int j = 0; j < T; j++) {
+        const float s = simd_sum(dot(qd, float4(*(const device half4*)(kh + (size_t)(main_ + j) * k_strides[2]))));
+        if (lane == 0) sp[sg][j] = s;
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    const float sc = scale[0];
+    float m_t = -1.0e30f;                                            // key kv_len - q_len is in the tail, seen by all
+    for (int j = 0; j < T; j++)
+        if (main_ + j <= last) m_t = max(m_t, (sp[0][j] + sp[1][j]) * sc);
+    float l_t = 0.0f;
+    float4 o_t = float4(0.0f);
+    for (int j = 0; j < T; j++) {
+        if (main_ + j > last) continue;
+        const float p = fast::exp((sp[0][j] + sp[1][j]) * sc - m_t);
+        l_t += p;
+        o_t += p * float4(*(const device half4*)(vh + (size_t)(main_ + j) * v_strides[2]));
+    }
+    const device float* ml = ml_part + ((size_t)h * n_chunks * r8 + row) * 2;
+    float m = m_t;
+    for (int c = 0; c < n_chunks; c++) m = max(m, ml[(size_t)c * r8 * 2]);
+    const float w_t = fast::exp(m_t - m);
+    float den = w_t * l_t;
+    float4 num = w_t * o_t;
+    for (int c = 0; c < n_chunks; c++) {
+        const float w = fast::exp(ml[(size_t)c * r8 * 2] - m);
+        den += w * ml[(size_t)c * r8 * 2 + 1];
+        num += w * *(const device float4*)(o_part + (((size_t)h * n_chunks + c) * r8 + row) * 256 + 4 * t);
+    }
+    *(device half4*)(out + ((size_t)h * rows + row) * 256 + 4 * t) = half4(num / den);
+"""
+
+_KERNELS: Optional[tuple[Any, Any]] = None
+_QIDX: dict[int, mx.array] = {}
+
+
+def _kernels():
+    global _KERNELS
+    if _KERNELS is None:
+        _KERNELS = (
+            mx.fast.metal_kernel(
+                name="dflash_splitk_gqa",
+                input_names=["qfrag", "k", "v", "params", "scale"],
+                output_names=["o_part", "ml_part"],
+                source=_SOURCE,
+                header=_HEADER,
+                ensure_row_contiguous=False,   # k/v are views into the KV cache: read in place, never copied
+            ),
+            mx.fast.metal_kernel(
+                name="dflash_splitk_merge",
+                input_names=["o_part", "ml_part", "q", "k", "v", "params", "scale"],
+                output_names=["out"],
+                source=_MERGE,
+                ensure_row_contiguous=False,
+            ),
+        )
+    return _KERNELS
+
+
+def _qidx(rt: int) -> mx.array:
+    """Gather index: Q [rt * 8 rows, 256] -> [d-group, row tile, lane, 8 halves], the B fragments of S^T = K Q^T
+    with lane (fm, fn) holding Q[8 i + fn + e % 2][32 dg + 4 (fm & ~1) + 2 (e // 2) + (fm & 1)] at element e."""
+    if rt not in _QIDX:
+        lane = mx.arange(32).reshape(1, 1, 32, 1)
+        fm = ((lane // 4) & 4) + ((lane // 2) % 4)
+        fn = ((lane // 4) & 2) * 2 + (lane % 2) * 2
+        dg = mx.arange(8).reshape(8, 1, 1, 1)
+        i = mx.arange(rt).reshape(1, rt, 1, 1)
+        e = mx.arange(8).reshape(1, 1, 1, 8)
+        idx = (8 * i + fn + e % 2) * _HEAD_DIM + 32 * dg + 4 * (fm - fm % 2) + 2 * (e // 2) + fm % 2
+        _QIDX[rt] = idx.reshape(-1).astype(mx.int32)
+    return _QIDX[rt]
+
+
+def splitk_gqa_attention(
+    queries: mx.array, keys: mx.array, values: mx.array, *, scale: float, mask: Optional[Any]
+) -> Optional[mx.array]:
+    """Attention of `queries` [1, H, Q, 256] over `keys`/`values` [1, KVH, L, 256] (fp16, last dim contiguous), mask
+    None or "causal" (tail-aligned). Returns None where it does not apply; the caller then uses its own path."""
+    b, h, q_len, d = queries.shape
+    kvh, kv_len = keys.shape[1], keys.shape[2]
+    if (
+        b != 1 or d != _HEAD_DIM or q_len > 8 or kvh <= 0 or h % kvh
+        or not (mask is None or (isinstance(mask, str) and mask == "causal"))
+        or queries.dtype != mx.float16 or keys.dtype != mx.float16 or values.dtype != mx.float16
+    ):
+        return None
+    causal = mask is not None
+    # keys every query sees, in whole blocks; at least one key is left for the tail so it is never empty
+    main = ((kv_len - (q_len if causal else 1)) // _CH) * _CH
+    total_blk = main // _CH
+    rows = (h // kvh) * q_len
+    rt = (rows + 7) // 8
+    if total_blk < 2 or kv_len < MIN_KV_LEN or rt > 8:
+        return None
+    queries = mx.contiguous(queries)
+    qg = queries.reshape(kvh, rows, d)
+    if rt * 8 != rows:
+        qg = mx.concatenate([qg, mx.zeros((kvh, rt * 8 - rows, d), dtype=qg.dtype)], axis=1)
+    qf = mx.contiguous(mx.take(qg.reshape(kvh, rt * 8 * d), _qidx(rt), axis=1))
+    n_blk = -(-total_blk // _TARGET_CHUNKS)
+    n_chunks = -(-total_blk // n_blk)
+    kern, merge = _kernels()
+    o_part, ml = kern(
+        inputs=[qf, keys, values, mx.array([total_blk, n_blk], dtype=mx.int32), mx.array([scale], dtype=mx.float32)],
+        template=[("RT", rt)],
+        grid=(n_chunks * 256, kvh, 1),
+        threadgroup=(256, 1, 1),
+        output_shapes=[(kvh, n_chunks, rt * 8, d), (kvh, n_chunks, rt * 8, 2)],
+        output_dtypes=[mx.float32, mx.float32],
+    )
+    (out,) = merge(
+        inputs=[o_part, ml, queries, keys, values,
+                mx.array([kv_len, q_len, int(causal), main, n_chunks, rows, rt * 8], dtype=mx.int32),
+                mx.array([scale], dtype=mx.float32)],
+        grid=(d // 4, rows, kvh),
+        threadgroup=(d // 4, 1, 1),
+        output_shapes=[(1, h, q_len, d)],
+        output_dtypes=[mx.float16],
+    )
+    return out
