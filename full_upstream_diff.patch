+    float ss = simd_sum(o.x*o.x + o.y*o.y + o.z*o.z + o.w*o.w);
+    float rstd = rsqrt(ss * (1.0f / 128.0f) + 1e-6f);
+    float4 xn = float4(half4(o * rstd * w));
+    float4 sz = z / (1.0f + exp(-z));
+    *(device half4*)(y_out + (size_t)idx * 128 + d0) = half4(xn * sz);
+"""
+
+_SRC_GDN_NORM_PREP = r"""
+    const uint tid = thread_position_in_threadgroup.x;
+    const uint lane = thread_index_in_simdgroup;
+    const uint sg = simdgroup_index_in_threadgroup;
+    const uint blk = threadgroup_position_in_grid.x;
+    const uint m = threadgroup_position_in_grid.y;
+    const uint k0 = blk * 1024;
+    const uint h = blk * 8 + sg;
+    const uint d0 = lane * 4;
+    const uint K = HV * 128;
+    const uint CONV_DIM = (2 * HK + HV) * 128;
+    const uint QKVZ_DIM = (2 * HK + 2 * HV) * 128;
+    const uint idx = m * HV + h;
+
+    const float4 o = float4(*(const device half4*)(out_in + (size_t)idx * 128 + d0));
+    const float4 z = float4(*(const device half4*)(qkvz + (size_t)m * QKVZ_DIM + CONV_DIM + h * 128 + d0));
+    const float4 w = float4(*(const device half4*)(norm_w + d0));
+    const float4 sg4 = float4(*(const device half4*)(signs + k0 + sg * 128 + d0));
+
+    float ss = simd_sum(o.x*o.x + o.y*o.y + o.z*o.z + o.w*o.w);
+    float rstd = rsqrt(ss * (1.0f / 128.0f) + 1e-6f);
+    float4 xn = float4(half4(o * rstd * w));
+    float4 sz = z / (1.0f + exp(-z));
+    float4 v = float4(half4(xn * sz)) * sg4;
+""" + _SRC_PREP_STORE_TAIL
+
+_SRC_PREP_SWIGLU = r"""
+    const uint tid = thread_position_in_threadgroup.x;
+    const uint lane = thread_index_in_simdgroup;
+    const uint m = threadgroup_position_in_grid.y;
+    const uint blk = threadgroup_position_in_grid.x;
+    const uint k0 = blk * 1024;
+    const device half* gur = gu + (size_t)m * (2 * K);
+    const half4 g4 = *(const device half4*)(gur + k0 + tid * 4);
+    const half4 u4 = *(const device half4*)(gur + K + k0 + tid * 4);
+    const float4 sg4 = float4(*(const device half4*)(signs + k0 + tid * 4));
+    const half4 sig_g = half4(1.0f / (1.0f + exp(-float4(g4))));
+    const half4 sw = (g4 * sig_g) * u4;
+    float4 v = float4(sw) * sg4;
+""" + _SRC_PREP_STORE_TAIL
+
+_SRC_ATTN_QKV_NORM_ROPE = r"""
+    const uint lane = thread_index_in_simdgroup;
+    const uint sg = simdgroup_index_in_threadgroup;
+    const uint idx = threadgroup_position_in_grid.x * 4 + sg;
+    const uint TOTAL_H = HQ + 2 * HKV;
+    if (idx >= S * TOTAL_H) return;
+
+    const uint s = idx / TOTAL_H;
+    const uint h_all = idx - s * TOTAL_H;
+    const uint Q_DIM = HQ * 512;
+    const uint K_DIM = HKV * 256;
+    const uint QKV_DIM = Q_DIM + 2 * K_DIM;
+
+    if (h_all >= HQ + HKV) {
+        const uint hv = h_all - (HQ + HKV);
+        const device half* src = qkv + (size_t)s * QKV_DIM + Q_DIM + K_DIM + hv * 256;
+        device half* dst = v_out + ((size_t)hv * S + s) * 256;
+        *(device half4*)(dst + lane * 4) = *(const device half4*)(src + lane * 4);
+        *(device half4*)(dst + 128 + lane * 4) = *(const device half4*)(src + 128 + lane * 4);
+        return;
+    }
+
+    const bool is_q = (h_all < HQ);
+    const uint h = is_q ? h_all : (h_all - HQ);
+    const device half* src = is_q
+        ? (qkv + (size_t)s * QKV_DIM + h * 512)
+        : (qkv + (size_t)s * QKV_DIM + Q_DIM + h * 256);
+    const device half* nw = is_q ? q_norm_w : k_norm_w;
+    device half* dst = is_q
+        ? (q_out + ((size_t)h * S + s) * 256)
+        : (k_out + ((size_t)h * S + s) * 256);
+
+    float v0 = float(src[lane]);
+    float v1 = float(src[lane + 32]);
+    float v2 = float(src[lane + 64]);
+    float v3 = float(src[lane + 96]);
+    float v4 = float(src[lane + 128]);
+    float v5 = float(src[lane + 160]);
+    float v6 = float(src[lane + 192]);
+    float v7 = float(src[lane + 224]);
+
+    float ss = simd_sum(v0*v0 + v1*v1 + v2*v2 + v3*v3 + v4*v4 + v5*v5 + v6*v6 + v7*v7);
+    float rstd = metal::precise::rsqrt(ss * (1.0f / 256.0f) + 1e-6f);
+
+    half h0 = half(v0 * rstd * float(nw[lane]));
+    half h1 = half(v1 * rstd * float(nw[lane + 32]));
+    dst[lane + 64]  = half(v2 * rstd * float(nw[lane + 64]));
+    dst[lane + 96]  = half(v3 * rstd * float(nw[lane + 96]));
+    dst[lane + 128] = half(v4 * rstd * float(nw[lane + 128]));
+    dst[lane + 160] = half(v5 * rstd * float(nw[lane + 160]));
+    dst[lane + 192] = half(v6 * rstd * float(nw[lane + 192]));
+    dst[lane + 224] = half(v7 * rstd * float(nw[lane + 224]));
+
+    float pos = float(int(rope_offset) + int(s));
+    float inv_freq = metal::precise::exp(-float(2 * lane) * (1.0f / 64.0f) * metal::precise::log(10000000.0f));
+    float theta = pos * inv_freq;
+    float c = metal::fast::cos(theta);
+    float sn = metal::fast::sin(theta);
+    float x0 = float(h0);
+    float x1 = float(h1);
+    dst[lane]      = half(x0 * c - x1 * sn);
+    dst[lane + 32] = half(x0 * sn + x1 * c);
+"""
+
+_SRC_ATTN_GATE_PREP = r"""
+    const uint tid = thread_position_in_threadgroup.x;
+    const uint lane = thread_index_in_simdgroup;
+    const uint m = threadgroup_position_in_grid.y;
+    const uint blk = threadgroup_position_in_grid.x;
+    const uint k0 = blk * 1024;
+    const uint h = blk * 4 + (tid >> 6);
+    const uint d0 = (tid & 63u) * 4;
+    const uint QKV_DIM = HQ * 512 + HKV * 512;
+    const uint K = HQ * 256;
+
+    const half4 o4 = *(const device half4*)(attn_out + ((size_t)h * M + m) * 256 + d0);
+    const half4 g4 = *(const device half4*)(qkv + (size_t)m * QKV_DIM + (size_t)h * 512 + 256 + d0);
+    const float4 sg4 = float4(*(const device half4*)(signs + k0 + tid * 4));
+    const half4 sig4 = half4(1.0f / (1.0f + exp(-float4(g4))));
+    const half4 y4 = o4 * sig4;
+    float4 v = float4(y4) * sg4;
+""" + _SRC_PREP_STORE_TAIL
+
+_SRC_HAD_BLOCK_LOOP = r"""
+    {
+        const float a0 = v.x + v.y, a1 = v.x - v.y, a2 = v.z + v.w, a3 = v.z - v.w;
+        v = float4(a0 + a2, a1 + a3, a0 - a2, a1 - a3);
+    }
+    #pragma unroll
+    for (uint d = 1; d <= 16; d <<= 1) {
+        const float4 o = simd_shuffle_xor(v, ushort(d));
+        v = ((lane & d) == 0) ? (v + o) : (o - v);
+    }
+    buf4[tid] = v;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    {
+        const uint base = tid & 31u;
+        const uint sub = tid >> 5;
+        const float4 u0 = buf4[base + 0 * 32], u1 = buf4[base + 1 * 32];
+        const float4 u2 = buf4[base + 2 * 32], u3 = buf4[base + 3 * 32];
+        const float4 u4 = buf4[base + 4 * 32], u5 = buf4[base + 5 * 32];
+        const float4 u6 = buf4[base + 6 * 32], u7 = buf4[base + 7 * 32];
+        const float4 b0 = u0 + u1, b1 = u0 - u1, b2 = u2 + u3, b3 = u2 - u3;
+        const float4 b4 = u4 + u5, b5 = u4 - u5, b6 = u6 + u7, b7 = u6 - u7;
+        const float4 c0 = b0 + b2, c1 = b1 + b3, c2 = b0 - b2, c3 = b1 - b3;
+        const float4 c4 = b4 + b6, c5 = b5 + b7, c6 = b4 - b6, c7 = b5 - b7;
+        if (sub == 0) v = c0 + c4;
+        else if (sub == 1) v = c1 + c5;
+        else if (sub == 2) v = c2 + c6;
+        else if (sub == 3) v = c3 + c7;
+        else if (sub == 4) v = c0 - c4;
+        else if (sub == 5) v = c1 - c5;
+        else if (sub == 6) v = c2 - c6;
+        else v = c3 - c7;
+    }
+    v *= (1.0f / 32.0f);
+    const float vals[4] = {v.x, v.y, v.z, v.w};
+    if (M == 3) {
+        if (m < 2) {
+            #pragma unroll
+            for (uint i = 0; i < 4; ++i) { const uint k = tid * 4 + i; xt[(size_t)(k0 + k) * 2 + m] = half(vals[i]); }
+        } else {
+            #pragma unroll
+            for (uint i = 0; i < 4; ++i) { const uint k = tid * 4 + i; xt[(size_t)K * 2 + (k0 + k)] = half(vals[i]); }
+        }
+    } else if (M == 5) {
+        if (m < 4) {
+            #pragma unroll
+            for (uint i = 0; i < 4; ++i) { const uint k = tid * 4 + i; xt[(size_t)(k0 + k) * 4 + m] = half(vals[i]); }
+        } else {
+            #pragma unroll
+            for (uint i = 0; i < 4; ++i) { const uint k = tid * 4 + i; xt[(size_t)K * 4 + (k0 + k)] = half(vals[i]); }
+        }
+    } else if (M == 6) {
+        if (m < 4) {
+            #pragma unroll
+            for (uint i = 0; i < 4; ++i) { const uint k = tid * 4 + i; xt[(size_t)(k0 + k) * 4 + m] = half(vals[i]); }
+        } else {
+            #pragma unroll
+            for (uint i = 0; i < 4; ++i) { const uint k = tid * 4 + i; xt[(size_t)K * 4 + (size_t)(k0 + k) * 2 + (m - 4)] = half(vals[i]); }
+        }
+    } else if (M == 7) {
+        #pragma unroll
+        for (uint i = 0; i < 4; ++i) {
+            const uint k = tid * 4 + i;
+            xt[(size_t)(k0 + k) * 8 + m] = half(vals[i]);
+            if (m == 0) xt[(size_t)(k0 + k) * 8 + 7] = 0.0h;
+        }
+    } else {
+        #pragma unroll
+        for (uint i = 0; i < 4; ++i) {
+            const uint k = tid * 4 + i;
+            xt[(size_t)(k0 + k) * M + m] = half(vals[i]);
+        }
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+"""
+
+_SRC_RES_NORM_PREP = r"""
+    const uint tid = thread_position_in_threadgroup.x;
+    const uint lane = thread_index_in_simdgroup;
+    const uint sg = simdgroup_index_in_threadgroup;
+    const uint m = threadgroup_position_in_grid.y;
+    const uint K = 5120;
+    const size_t row_off = (size_t)m * K;
+
+    half4 h_reg[5];
+    float ss = 0.0f;
+    #pragma unroll
+    for (uint blk = 0; blk < 5; ++blk) {
+        const uint col = blk * 1024 + tid * 4;
+        const half4 x4 = *(const device half4*)(x + row_off + col);
+        const half4 r4 = *(const device half4*)(r + row_off + col);
+        const half4 h4 = x4 + r4;
+        *(device half4*)(h_out + row_off + col) = h4;
+        h_reg[blk] = h4;
+        const float4 f4 = float4(h4);
+        ss += dot(f4, f4);
+    }
+    ss = simd_sum(ss);
+    threadgroup float shared_ss[8];
+    if (lane == 0) shared_ss[sg] = ss;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (sg == 0) {
+        float s8 = (lane < 8) ? shared_ss[lane] : 0.0f;
+        s8 = simd_sum(s8);
+        if (lane == 0) shared_ss[0] = metal::precise::rsqrt(s8 * (1.0f / 5120.0f) + 1e-6f);
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    const float rstd = shared_ss[0];
+
+    threadgroup float4 buf4[256];
+    for (uint blk = 0; blk < 5; ++blk) {
+        const uint k0 = blk * 1024;
+        const uint col = k0 + tid * 4;
+        const half4 nw4 = *(const device half4*)(norm_w + col);
+        const half4 sg4 = *(const device half4*)(signs + col);
+        const half4 normed = half4(float4(h_reg[blk]) * rstd) * nw4;
+        float4 v = float4(normed) * float4(sg4);
+""" + _SRC_HAD_BLOCK_LOOP + "}\n"
+
+_kernel_gdn_conv_silu_norm_gb = None
+_kernel_gdn_norm_gated = None
+_kernel_gdn_norm_prep = None
+_kernel_prep_swiglu = None
+_kernel_attn_qkv_norm_rope = None
+_kernel_attn_gate_prep = None
+_kernel_res_norm_prep = None
+
+
+def get_gdn_fused_kernels():
+    global _kernel_gdn_conv_silu_norm_gb, _kernel_gdn_norm_gated, _kernel_gdn_norm_prep, _kernel_prep_swiglu
+    global _kernel_attn_qkv_norm_rope, _kernel_attn_gate_prep, _kernel_res_norm_prep
+    if _kernel_gdn_conv_silu_norm_gb is None:
+        hdr = "#include <metal_simdgroup>\n#include <metal_math>\nusing namespace metal;\n"
+        _kernel_gdn_conv_silu_norm_gb = mx.fast.metal_kernel(
+            name="gdn_conv_silu_norm_gb",
+            input_names=["conv_state", "qkvz", "conv_w", "ba", "A_log", "dt_bias"],
+            output_names=["q_out", "k_out", "v_out", "conv_input", "g_out", "beta_out"],
