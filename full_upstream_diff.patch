+        for (int t = 0; t < T; ++t) {
+          float g_val = float(*g_);
+          float beta_val = float(*beta_);
+          float4 kv = float4(*reinterpret_cast<const device packed_half4*>(k_));
+          float4 qv = float4(*reinterpret_cast<const device packed_half4*>(q_));
