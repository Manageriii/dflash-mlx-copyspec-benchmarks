diff --git a/tests/test_serve_prompt_trimming.py b/tests/test_serve_prompt_trimming.py
new file mode 100644
index 0000000..af8fc7b
--- /dev/null
+++ b/tests/test_serve_prompt_trimming.py
@@ -0,0 +1,58 @@
+# Only DSH compaction requests may be trimmed before tokenizing; every other prompt reaches the model whole.
+
+from __future__ import annotations
+
+import pytest
+
+from dflash_mlx.serve import DFlashAPIHandler, DFlashResponseGenerator
+from dflash_mlx.server.tool_calls import apply_tool_choice
+
+
+def _request_as_the_model_sees_it(body):
+    handler = object.__new__(DFlashAPIHandler)
+    handler.stream = False
+    handler.max_tokens = 4096
+    handler.body = body
+    request = DFlashAPIHandler.handle_chat_completions(handler)
+    apply_tool_choice(request, handler.tool_choice)
+    DFlashResponseGenerator._compact_request_messages_in_place(request)
+    return request
+
+
+_LOOKUP_TOOL = [{"type": "function", "function": {"name": "lookup"}}]
+
+
+@pytest.mark.parametrize(
+    "tool_fields",
+    [{}, {"tools": _LOOKUP_TOOL, "tool_choice": "none"}],
+    ids=["no-tools", "tool-choice-none"],
+)
+def test_long_tool_less_prompt_reaches_the_model_whole(tool_fields):
+    prompt = "Answer from this document.\n" + "lorem ipsum " * 12_000
+    request = _request_as_the_model_sees_it(
+        {"messages": [{"role": "user", "content": prompt}], **tool_fields}
+    )
+
+    assert request.tools is None
+    assert request.messages[-1]["content"] == prompt
+
+
+def test_dsh_compaction_request_is_still_trimmed():
+    content = (
+        "Conversation history to condense:\n\n"
+        + "earlier turn " * 4_000
+        + "\n\n---\n\nCondense the conversation ABOVE into a structured checkpoint."
+    )
+    request = _request_as_the_model_sees_it(
+        {
+            "messages": [
+                {"role": "system", "content": "You are DSH."},
+                {"role": "user", "content": content},
+            ],
+            "tools": _LOOKUP_TOOL,
+        }
+    )
+
+    trimmed = request.messages[-1]["content"]
+    assert "compaction input trimmed" in trimmed
+    assert len(trimmed) < 12_500
diff --git a/tests/test_splitk_attention.py b/tests/test_splitk_attention.py
new file mode 100644
index 0000000..7ff169b
--- /dev/null
+++ b/tests/test_splitk_attention.py
@@ -0,0 +1,78 @@
+from __future__ import annotations
+
+import mlx.core as mx
+import pytest
+
+from dflash_mlx.engine.splitk_attention import MIN_KV_LEN, splitk_gqa_attention
+
+H, KVH, D = 24, 4, 256
+
+
+def _inputs(kv_len: int, q_len: int, start: int = 0):
+    # K/V as views into a larger buffer, the way KVCache.update_and_fetch returns them
+    buf_k = (mx.random.normal((1, KVH, start + kv_len + 256, D)) * 0.5).astype(mx.float16)
+    buf_v = mx.random.normal((1, KVH, start + kv_len + 256, D)).astype(mx.float16)
+    q = (mx.random.normal((1, H, q_len, D)) * 0.5).astype(mx.float16)
+    return q, buf_k[:, :, start:start + kv_len, :], buf_v[:, :, start:start + kv_len, :]
+
+
+def _reference(q, k, v, scale, mask):
+    m = None
+    if mask == "causal":
+        kv_len, q_len = k.shape[2], q.shape[2]
+        m = mx.arange(kv_len)[None, :] <= mx.arange(kv_len - q_len, kv_len)[:, None]
+    return mx.fast.scaled_dot_product_attention(
+        q.astype(mx.float32), k.astype(mx.float32), v.astype(mx.float32), scale=scale, mask=m
+    )
+
+
+def _check(q, k, v, mask, tol=1e-3):
+    scale = D**-0.5
+    out = splitk_gqa_attention(q, k, v, scale=scale, mask=mask)
+    assert out is not None and out.shape == q.shape and out.dtype == mx.float16
+    err = mx.abs(out.astype(mx.float32) - _reference(q, k, v, scale, mask)).max().item()
+    assert err < tol, err
+
+
+@pytest.mark.parametrize("kv_len", [MIN_KV_LEN, MIN_KV_LEN + 135, 3 * MIN_KV_LEN + 7, 32768])
+@pytest.mark.parametrize("q_len,mask", [(1, None), (1, "causal"), (4, "causal"), (5, "causal"), (8, "causal")])
+def test_matches_fp32_attention(kv_len, q_len, mask):
+    mx.random.seed(kv_len + q_len)
+    _check(*_inputs(kv_len, q_len), mask)
+
+
+@pytest.mark.parametrize("q_len", [1, 8])
+@pytest.mark.parametrize("extra", [0, 127])
+def test_tail_lengths(q_len, extra):
+    # the merge kernel computes the last q_len .. q_len + 127 keys itself: both ends of that range
+    mx.random.seed(q_len + extra)
+    _check(*_inputs(64 * 128 + q_len + extra, q_len), "causal")
+
+
+def test_queries_as_a_transposed_view_and_kv_at_an_offset():
+    mx.random.seed(7)
+    q, k, v = _inputs(MIN_KV_LEN + 300, 8, start=512)
+    q_t = mx.contiguous(q.transpose(0, 2, 1, 3)).transpose(0, 2, 1, 3)   # [1, H, Q, D] view of [1, Q, H, D]
+    _check(q_t, k, v, "causal")
+
+
+def test_scores_that_jump_late_rescale_exactly():
+    # the kernel keeps P = exp(s - m_ref) against a reference max and rescales only when a score passes m_ref + 8:
+    # make the scores of a late stretch of keys jump far above the early ones, and the first keys tiny
+    mx.random.seed(11)
+    q, k, v = _inputs(3 * MIN_KV_LEN, 8)
+    boost = mx.ones((1, 1, k.shape[2], 1), dtype=mx.float16)
+    boost[:, :, 5000:5100] = 40.0
+    boost[:, :, :300] = 0.01
+    _check(q, k * boost, v, "causal", tol=2e-3)
+
+
+def test_declines_what_it_does_not_cover():
+    q, k, v = _inputs(MIN_KV_LEN, 8)
+    scale = D**-0.5
+    assert splitk_gqa_attention(q, k, v, scale=scale, mask=mx.ones((8, MIN_KV_LEN), dtype=mx.bool_)) is None
+    assert splitk_gqa_attention(q.astype(mx.bfloat16), k, v, scale=scale, mask="causal") is None
+    short_q, short_k, short_v = _inputs(MIN_KV_LEN // 2, 8)
+    assert splitk_gqa_attention(short_q, short_k, short_v, scale=scale, mask="causal") is None
+    long_q = mx.zeros((1, H, 16, D), dtype=mx.float16)
+    assert splitk_gqa_attention(long_q, k, v, scale=scale, mask="causal") is None
